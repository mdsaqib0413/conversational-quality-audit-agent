# ---- LLM (used by the audit itself) -----------------------------------------------------------
LLM_PROVIDER=gemini                     # gemini | openai_compat
GEMINI_API_KEY=your_gemini_api_key_here
# Run `python scripts/list_models.py` and use a model it prints.
GEMINI_MODEL=gemini-2.5-flash
# Optional: used automatically when the daily quota of the model above is gone (comma separated)
GEMINI_FALLBACK_MODELS=

# Optional second provider (Groq, OpenRouter, or a local Ollama), used as a fallback or as the main LLM.
# Groq example:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=<a model from your Groq console>
# Ollama example: LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.1   LLM_API_KEY=
LLM_FALLBACK_PROVIDER=                  # openai_compat to enable
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Speech to text ---------------------------------------------------------------------------
WHISPER_MODEL=small                     # tiny | base | small | medium (smaller = faster on CPU)
WHISPER_LANGUAGE=auto                   # auto (faster-whisper auto-detect) | en | te | hi

# ---- Retrieval --------------------------------------------------------------------------------
USE_EMBEDDINGS=1                        # 0 = keyword (BM25) retrieval only

# ---- Vector store -----------------------------------------------------------------------------
VECTOR_STORE=qdrant                     # qdrant | numpy (numpy = in-memory matrix, no database)
# Leave empty for embedded local Qdrant (data/qdrant_db). Set to use a Qdrant server or Qdrant Cloud:
QDRANT_URL=
QDRANT_API_KEY=
