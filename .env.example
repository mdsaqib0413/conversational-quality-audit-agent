# Google Gemini API Key (Get a key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (Must be explicitly specified; run 'python scripts/list_models.py'
# to list all models available for your API key that support generateContent, e.g. gemini-2.0-flash or gemini-2.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Whisper Model size for transcription (tiny, base, small, medium, large-v3)
WHISPER_MODEL=small

# Optional HuggingFace Token for diarization or restricted models
HF_TOKEN=your_huggingface_token_here

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=data/chroma_db
